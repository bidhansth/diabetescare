{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBReadMonthOfEntries",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Query",
        "dynamodb:GetItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:*:table/DiabetesCare"
    },
    {
      "Sid": "S3WriteAndPresignReports",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectAcl",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::diabetescare-reports-484504929783-us-east-1-an/*"
    }
  ]
}
